# skhd hotkeys for yabai. skhd has no variables, so each binding spells out
# its modifiers and the full yabai command.
#
# The modifier is Ctrl+Option: Option alone types letters on the Polish Pro
# layout (Option+e is ę, Option+s is ś), Ctrl+Shift belongs to Rex, and
# Ctrl+Option+letter types nothing on any layout. On the Ferris Sweep hold
# S and D for keys on the right hand, or L and K for keys on the left hand.

# ===== 1. application launcher & terminal ==============================
ctrl + alt - return : open -na "Terminal"
# Spotlight replacement; swap the app if preferred.
ctrl + alt - d : open -a "Raycast"

# ===== 2. focus ========================================================
ctrl + alt - h : yabai -m window --focus west
ctrl + alt - j : yabai -m window --focus south
ctrl + alt - k : yabai -m window --focus north
ctrl + alt - l : yabai -m window --focus east

# arrow keys too
ctrl + alt - left  : yabai -m window --focus west
ctrl + alt - down  : yabai -m window --focus south
ctrl + alt - up    : yabai -m window --focus north
ctrl + alt - right : yabai -m window --focus east

# ===== 3. move =========================================================
ctrl + alt + shift - h : yabai -m window --warp west
ctrl + alt + shift - j : yabai -m window --warp south
ctrl + alt + shift - k : yabai -m window --warp north
ctrl + alt + shift - l : yabai -m window --warp east

# ===== 4. layout toggles ===============================================
ctrl + alt - f         : yabai -m window --toggle zoom-fullscreen
ctrl + alt + shift - space : yabai -m window --toggle float
# i3 stacking
ctrl + alt - s : yabai -m space --layout stack
# close enough to i3 tabbed
ctrl + alt - w : yabai -m space --layout float
# back to split
ctrl + alt - e : yabai -m space --layout bsp

# ===== 5. workspaces (spaces) ==========================================
# jump
ctrl + alt - 1 : yabai -m space --focus 1
ctrl + alt - 2 : yabai -m space --focus 2
ctrl + alt - 3 : yabai -m space --focus 3
ctrl + alt - 4 : yabai -m space --focus 4
ctrl + alt - 5 : yabai -m space --focus 5
ctrl + alt - 6 : yabai -m space --focus 6
ctrl + alt - 7 : yabai -m space --focus 7
ctrl + alt - 8 : yabai -m space --focus 8
ctrl + alt - 9 : yabai -m space --focus 9
ctrl + alt - 0 : yabai -m space --focus 10

# send + follow + balance
ctrl + alt + shift - 1 : yabai -m window --space 1;  yabai -m space --focus 1;  yabai -m space --balance
ctrl + alt + shift - 2 : yabai -m window --space 2;  yabai -m space --focus 2;  yabai -m space --balance
ctrl + alt + shift - 3 : yabai -m window --space 3;  yabai -m space --focus 3;  yabai -m space --balance
ctrl + alt + shift - 4 : yabai -m window --space 4;  yabai -m space --focus 4;  yabai -m space --balance
ctrl + alt + shift - 5 : yabai -m window --space 5;  yabai -m space --focus 5;  yabai -m space --balance
ctrl + alt + shift - 6 : yabai -m window --space 6;  yabai -m space --focus 6;  yabai -m space --balance
ctrl + alt + shift - 7 : yabai -m window --space 7;  yabai -m space --focus 7;  yabai -m space --balance
ctrl + alt + shift - 8 : yabai -m window --space 8;  yabai -m space --focus 8;  yabai -m space --balance
ctrl + alt + shift - 9 : yabai -m window --space 9;  yabai -m space --focus 9;  yabai -m space --balance
ctrl + alt + shift - 0 : yabai -m window --space 10; yabai -m space --focus 10; yabai -m space --balance
